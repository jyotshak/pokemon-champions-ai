__pycache__/
*.pyc
.venv/
venv/
.env

node_modules/
logs/

# Generated replay artifacts - all reproducible from scrape/parse/reconstruct,
# and far too large to track (raw 49M, parsed 14M, examples 104M).
replays/raw/
replays/parsed/
replays/examples/
# Local manifest of which replay ids are folded into replays/examples/ -
# derived state tied to this machine's replays/raw/ cache (regenerated by a
# full `python -m replays.reconstruct`), not portable source.
replays/trained_ids.json

# Trained model weights - reproducible via `python -m model.train`.
model/checkpoints/*.pt

# Third-party download, not part of this project's source.
Showdown-Singleplayer-main/

# Vendored local Showdown server (engine/bridge.js drives it to run actual
# battles - tracked so a fresh clone can run matches without a separate
# clone/build step). node_modules/ above already excludes its installed
# deps (run `npm install` in vendor/pokemon-showdown/ once after cloning);
# these exclude its other generated/local-only content. dist/ (compiled
# JS) IS tracked deliberately, so the server runs with no build step.
vendor/pokemon-showdown/databases/*.db*
vendor/pokemon-showdown/.eslintcache
vendor/pokemon-showdown/*.tsbuildinfo
vendor/pokemon-showdown/dist/**/*.map

.vscode/
.idea/
